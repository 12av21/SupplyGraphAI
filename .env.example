# SCIP - Smart Community Intelligence Platform Environment Configuration

# Server & Network
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Authentication & Security
JWT_SECRET="scip-master-secure-jwt-secret-key-2026"

# Database Configuration (MongoDB URI)
MONGODB_URI="mongodb://127.0.0.1:27017/scip"

# AI/ML Engine Service
AI_SERVICE_URL="http://localhost:8000"

# GEMINI_API_KEY: Optional for extended external LLM reasoning.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
